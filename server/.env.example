# Copy to .env and fill in before running docker-compose up

# Postgres
POSTGRES_USER=learnin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=learnin
DATABASE_URL=postgres://learnin:changeme@postgres:5432/learnin

# Redis (BullMQ job queue)
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Anthropic (lecture -> explainer/quiz generation)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Optional: self-hosted Whisper-compatible transcription server
# (e.g. onerahmet/openai-whisper-asr-webservice, exposes /v1/audio/transcriptions)
# Leave unset to disable video uploads.
WHISPER_API_URL=

# Expo push notifications need no secret for the default Expo push service

PORT=4000
UPLOAD_DIR=/app/uploads

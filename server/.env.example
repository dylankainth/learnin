# Copy to .env and fill in before running docker-compose up

# PocketBase (self-hosted — runs as the `pocketbase` service in
# docker-compose.yml, backing both auth and the app's database/file storage).
# Inside docker-compose the api/worker reach it over the compose network.
POCKETBASE_URL=http://pocketbase:8090
# These must match the pocketbase service's PB_ADMIN_EMAIL/PB_ADMIN_PASSWORD
# below (same names, same values) — the server authenticates as this
# superuser to read/write across all users' records; your own route code is
# what enforces "only your own data".
PB_ADMIN_EMAIL=admin@learnin.local
PB_ADMIN_PASSWORD=changeme-please

# Redis (BullMQ job queue)
REDIS_URL=redis://redis:6379

# OpenRouter (lecture -> explainer/quiz generation)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Good default: cheap, 1M context, reliable structured JSON output.
# Cheaper alt: google/gemini-2.5-flash-lite. Cheapest capable open-weight
# alt: deepseek/deepseek-v3.2. See README for a fuller comparison.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional — shown on your OpenRouter dashboard, not required to function.
OPENROUTER_SITE_URL=https://github.com/dylankainth/learnin
OPENROUTER_APP_NAME=Learnin

# Optional: self-hosted Whisper-compatible transcription server
# (e.g. onerahmet/openai-whisper-asr-webservice, exposes /v1/audio/transcriptions)
# Leave unset to disable video uploads.
WHISPER_API_URL=

# Expo push notifications need no secret for the default Expo push service

PORT=4000

{
  "expo": {
    "name": "Learnin",
    "slug": "learnin",
    "scheme": "learnin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.learnin.app",
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C4FE0"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://learnin.projects.dylankainth.com",
      "pocketbaseUrl": "http://localhost:8090",
      "router": {},
      "eas": {
        "projectId": "89a85734-b010-4c5d-86a2-605ab316c55f"
      }
    }
  }
}
